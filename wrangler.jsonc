{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happy-pigs",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-30",
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "GameRoom"}]},
  "ratelimits": [{"name":"ROOM_LIMITER","namespace_id":"746447","simple":{"limit":20,"period":60}}],
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameRoom"]}]
}
